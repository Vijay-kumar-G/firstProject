class Solution {
    public int smallestIndex(int[] nums) {
        for(int i=0;i<nums.length;i++){
            int digitSum=digi(nums[i]);
            if(digitSum==i){
                return i;
            }
        }
        return -1;
    }

    public int digi(int n){
        int temp=n;
        int sum=0;
        while(temp>0){
            int dig=temp%10;
            sum+=dig;
            temp/=10;
        }
        return sum;
    }
} //by vj
