
class Solution {
    public int maxProduct(int n) {
        String s = String.valueOf(n);
        char[] chars = s.toCharArray();
        Arrays.sort(chars);
        int n1 = Character.getNumericValue(chars[chars.length-1]);  //old way to convert char into int
        int n2 = chars[chars.length-2] - '0';                       //fast way to convert char into int
        return n1*n2;
    }
}// by vj
